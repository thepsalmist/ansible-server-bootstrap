      "transformations": [
        {
          "id": "timeSeriesTable",
          "options": {
            "E": {
              "timeField": "Time",
              "stat": "sum"
            }
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "task",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time": true
            },
            "indexByName": {
              "task": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Trend #E": 5
            },
            "renameByName": {
              "task": "Task",
              "Value #A": "Runs",
              "Value #B": "Failed",
              "Value #C": "Succeeded",
              "Value #D": "p95",
              "Trend #E": "Runs over time"
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "Runs",
                "config": {
                  "id": "greater",
                  "options": {
                    "value": 0
                  }
                }
              }
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "Failed",
              "operator": "*",
              "right": "1000000"
            },
            "alias": "failed first"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "binary": {
              "left": "failed first",
              "operator": "+",
              "right": "Runs"
            },
            "alias": "order"
