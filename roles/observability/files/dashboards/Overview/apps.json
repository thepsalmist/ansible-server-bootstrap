{
  "uid": "dokku-apps",
  "title": "Apps",
  "tags": [
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_memory_working_set_bytes{container_label_com_dokku_app_name!=\"\"}, container_label_com_dokku_app_name)",
          "refId": "app"
        },
        "definition": "label_values(container_memory_working_set_bytes{container_label_com_dokku_app_name!=\"\"}, container_label_com_dokku_app_name)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "otlp",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(target_info{app=\"$app\"}, app)",
          "refId": "otlp"
        },
        "definition": "label_values(target_info{app=\"$app\"}, app)",
        "refresh": 2
      },
      {
        "name": "jobs",
        "type": "query",
        "hide": 2,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(${app}_jobs_total{app=\"$app\"}, app)",
          "refId": "jobs"
        },
        "definition": "label_values(${app}_jobs_total{app=\"$app\"}, app)",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Health check",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "min(probe_success{app=\"$app\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Failing",
                  "color": "red"
                },
                "1": {
                  "text": "Passing",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Certificate expires in",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "min(probe_ssl_earliest_cert_expiry{app=\"$app\"}) - time()",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1209600
              },
              {
                "color": "green",
                "value": 2592000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "title": "Requests",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 8,
        "y": 1
      },
      "description": "Requests nginx served in the selected time range, not counting health checks.",
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"nginx\", app=\"$app\"} | json status, user_agent | user_agent !~ \"Blackbox-Exporter/.*\" [$__range])) or vector(0)",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Server errors (5xx)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 13,
        "y": 1
      },
      "description": "Responses with status 500 or above. The share turns orange at 1% and red at 5%.",
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"nginx\", app=\"$app\"} | json status, user_agent | user_agent !~ \"Blackbox-Exporter/.*\" | status >= 500 [$__range])) or vector(0)",
          "queryType": "instant",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "expr": "(sum(count_over_time({job=\"nginx\", app=\"$app\"} | json status, user_agent | user_agent !~ \"Blackbox-Exporter/.*\" | status >= 500 [$__range])) or vector(0)) / sum(count_over_time({job=\"nginx\", app=\"$app\"} | json status, user_agent | user_agent !~ \"Blackbox-Exporter/.*\" [$__range]))",
          "queryType": "instant",
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "errors"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "of requests"
              },
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Processes reporting",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "expr": "count by (process_type) (target_info{app=\"$app\"})",
          "legendFormat": "{{process_type}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (process_type) (up{job=\"apps\", app=\"$app\"})",
          "legendFormat": "{{process_type}} (scraped)",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "row",
      "title": "Pages",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "repeat": "otlp",
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Requests by page",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 0,
        "y": 7
      },
      "description": "Requests to each page in the selected time range, busiest first.",
      "targets": [
        {
          "expr": "sort_desc(sum by (http_route) (increase(http_server_request_duration_seconds_count{app=\"$app\", http_route!=\"\"}[$__range] anchored)) > 0)",
          "legendFormat": "{{http_route}}",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showUnfilled": true,
        "namePlacement": "left",
        "valueMode": "color",
        "sizing": "manual",
        "minVizHeight": 22,
        "maxVizHeight": 22,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Other requests",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 5,
        "x": 9,
        "y": 7
      },
      "description": "Requests the app answered before matching a page: static files (including 304 Not Modified), redirects, not found (404) and anything else.",
      "targets": [
        {
          "expr": "sort_desc(sum by (http_route) (label_replace(label_replace(label_replace(label_replace(sum by (http_response_status_code) (increase(http_server_request_duration_seconds_count{app=\"$app\", http_route=\"\"}[$__range] anchored)), \"http_route\", \"other\", \"http_response_status_code\", \".*\"), \"http_route\", \"static files\", \"http_response_status_code\", \"2..|304\"), \"http_route\", \"redirects\", \"http_response_status_code\", \"30[1278]\"), \"http_route\", \"not found\", \"http_response_status_code\", \"404\")) > 0)",
          "legendFormat": "{{http_route}}",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showUnfilled": true,
        "namePlacement": "left",
        "valueMode": "color",
        "sizing": "manual",
        "minVizHeight": 22,
        "maxVizHeight": 22,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "displayMode": "gradient"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "p95 response time by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 7
      },
      "description": "95% of requests to each page finished faster than this, over the selected time range. Yellow from 300 ms, red from 800 ms.",
      "targets": [
        {
          "expr": "sort_desc(histogram_quantile(0.95, sum by (le, http_route) (increase(http_server_request_duration_seconds_bucket{app=\"$app\", http_route!=\"\"}[$__range] anchored))) > 0)",
          "legendFormat": "{{http_route}}",
          "instant": true,
          "range": false,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showUnfilled": true,
        "namePlacement": "left",
        "valueMode": "color",
        "sizing": "manual",
        "minVizHeight": 22,
        "maxVizHeight": 22,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "displayMode": "lcd"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Jobs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "repeat": "jobs",
      "panels": []
    },
    {
      "type": "stat",
      "title": "Failed jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "description": "Jobs of any task that failed in the selected time range.",
      "targets": [
        {
          "expr": "sum(increase(${app}_jobs_total{app=\"$app\", status=\"failed\"}[$__range] anchored)) or vector(0)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Waiting now",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 16
      },
      "description": "Jobs waiting for a worker, and jobs running.",
      "targets": [
        {
          "expr": "max(${app}_queue_depth{app=\"$app\", status=\"todo\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        },
        {
          "expr": "max(${app}_queue_depth{app=\"$app\", status=\"doing\"})",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "waiting"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "running"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "description": "The most jobs waiting and running in each interval. A rising waiting line means the workers are falling behind.",
      "maxDataPoints": 168,
      "interval": "2m",
      "targets": [
        {
          "expr": "max by (status) (max_over_time(${app}_queue_depth{app=\"$app\"}[$__interval]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "todo"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "waiting"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "doing"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "running"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "status-history",
      "title": "Runs by task",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "description": "One cell per task per interval: green when the task ran, red when a run failed, empty when it didn't run.",
      "maxDataPoints": 168,
      "interval": "1m",
      "targets": [
        {
          "expr": "(sum by (task) (increase(${app}_jobs_total{app=\"$app\", status=\"failed\"}[$__interval] anchored)) > 0) * 0 + 2 or (sum by (task) (increase(${app}_jobs_total{app=\"$app\"}[$__interval] anchored)) > 0) * 0 + 1",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{task}}"
        }
      ],
      "options": {
        "showValue": "never",
        "rowHeight": 0.9,
        "colWidth": 0.9,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ran",
                  "color": "green"
                },
                "2": {
                  "text": "failed",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Tasks",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "description": "Tasks that ran in the selected time range, tasks with failures first.",
      "maxDataPoints": 168,
      "interval": "1m",
      "targets": [
        {
          "expr": "sum by (task) (increase(${app}_jobs_total{app=\"$app\"}[$__range] anchored))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "sum by (task) (increase(${app}_jobs_total{app=\"$app\", status=\"failed\"}[$__range] anchored)) or sum by (task) (increase(${app}_jobs_total{app=\"$app\"}[$__range] anchored)) * 0",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "(sum by (task) (increase(${app}_jobs_total{app=\"$app\", status=\"succeeded\"}[$__range] anchored)) or sum by (task) (increase(${app}_jobs_total{app=\"$app\"}[$__range] anchored)) * 0) / sum by (task) (increase(${app}_jobs_total{app=\"$app\"}[$__range] anchored))",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, task) (increase(${app}_job_duration_seconds_bucket{app=\"$app\"}[$__range] anchored)))",
          "refId": "D",
          "datasource": {
