name: observability

networks:
  default:
    name: {{ observability_network }}
    external: true

volumes:
  prometheus-data:
  loki-data:
  alloy-data:

services:
  prometheus:
    image: prom/prometheus:{{ observability_prometheus_version }}
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ observability_prometheus_retention }}
    group_add: ["{{ observability_docker_gid }}"]
    volumes:
      - ./prometheus:/etc/prometheus:ro
      - prometheus-data:/prometheus
      - /var/run/docker.sock:/var/run/docker.sock:ro
    restart: unless-stopped

  loki:
    image: grafana/loki:{{ observability_loki_version }}
    command: -config.file=/etc/loki/config.yaml
    volumes:
      - ./loki:/etc/loki:ro
      - loki-data:/loki
    restart: unless-stopped

  alloy:
    image: grafana/alloy:{{ observability_alloy_version }}
    command:
      - run
      - /etc/alloy/config.alloy
      - --storage.path=/var/lib/alloy
      - --server.http.listen-addr=0.0.0.0:12345
    volumes:
      - ./alloy:/etc/alloy:ro
      - alloy-data:/var/lib/alloy
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /var/log:/var/log:ro
      - /run/log/journal:/run/log/journal:ro
      - /etc/machine-id:/etc/machine-id:ro
    restart: unless-stopped

  node-exporter:
    image: prom/node-exporter:{{ observability_node_exporter_version }}
    command:
      - --path.rootfs=/host
      - --web.listen-address={{ observability_gateway }}:9100
    network_mode: host
    pid: host
    volumes:
      - /:/host:ro,rslave
    restart: unless-stopped

  cadvisor:
    image: ghcr.io/google/cadvisor:{{ observability_cadvisor_version }}
    command:
      - --docker_only=true
      - --housekeeping_interval=30s
      - --store_container_labels=false
      - --whitelisted_container_labels=com.dokku.app-name,com.dokku.process-type,com.docker.compose.service
    privileged: true
    devices: [/dev/kmsg]
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /dev/disk:/dev/disk:ro
    restart: unless-stopped

  blackbox:
    image: prom/blackbox-exporter:{{ observability_blackbox_version }}
    command: --config.file=/etc/blackbox/config.yml
    volumes:
      - ./blackbox:/etc/blackbox:ro
    restart: unless-stopped
