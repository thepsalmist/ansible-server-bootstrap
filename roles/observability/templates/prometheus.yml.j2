global:
  scrape_interval: 30s
  evaluation_interval: 30s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: [localhost:9090]

  - job_name: node
    static_configs:
      - targets: ["{{ observability_gateway }}:9100"]

  - job_name: cadvisor
    static_configs:
      - targets: [cadvisor:8080]

  - job_name: loki
    static_configs:
      - targets: [loki:3100]

  - job_name: alloy
    static_configs:
      - targets: [alloy:12345]

  - job_name: blackbox
    metrics_path: /probe
    params:
      module: [http_2xx]
    file_sd_configs:
      - files: [/etc/prometheus/probes.json]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115

  - job_name: apps
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        match_first_network: false
        filters:
          - name: label
            values: [observability.metrics.port]
    relabel_configs:
      - source_labels: [__meta_docker_network_name]
        regex: {{ observability_network }}
        action: keep
      - source_labels: [__meta_docker_network_ip, __meta_docker_container_label_observability_metrics_port]
        separator: ":"
        target_label: __address__
      - source_labels: [__meta_docker_container_name]
        regex: /(.*)
        target_label: instance
      - source_labels: [__meta_docker_container_label_com_dokku_app_name]
        target_label: app
      - source_labels: [__meta_docker_container_label_com_dokku_process_type]
        target_label: process_type
